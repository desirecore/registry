      "zh-CN": {
        "name": "视频创作",
        "summary": "可编辑影片、原创动效和带版本时点的真实画面审片；与视频导演协作并保留人工修改。",
        "description": "可编辑影片、原创动效和带版本时点的真实画面审片；与视频导演协作并保留人工修改。 复用OpenFilm渲染与编辑内核，支持HTML/SVG/Canvas/WebGL自主场景、时间窗总览、多尺寸与修订对照。需单独准备Node.js、pnpm、浏览器和FFmpeg；可选生成服务的许可、账户与费用另计。安装前检查app-authoring-v1的release/runtime-binding能力；目录来源或端口声明不等于已安装、已授权或当前在线。"
      },
      "en-US": {
        "name": "Video Creation",
        "summary": "Editable films, original motion scenes and versioned timed visual review, preserving human edits.",
        "description": "Reuses the OpenFilm editor and renderer for autonomous HTML/SVG/Canvas/WebGL scenes, temporal overviews, size comparison and revision pairs. Requires Node.js, pnpm, browser/FFmpeg and app-authoring-v1 release/runtime-binding capabilities. Optional model/media licenses, accounts and usage fees are separate. Catalog ports are adjustable installation defaults, not proof of a live runtime."
      }
