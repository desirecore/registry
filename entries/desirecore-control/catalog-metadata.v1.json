    "i18n": {
      "zh-CN": {
        "name": "DesireCore Control",
        "summary": "供外部智能体控制本机多个 DesireCore 实例的独立应用，内置 ChatGPT 隧道管理。",
        "description": "DesireCore Control 是独立开源的宿主机应用：自动识别本机实例、展示管理页面，并通过对外 MCP 提供窗口、截图与 CDP 操作。1.4.0 支持管理官方 ChatGPT tunnel-client。默认只读，不随 DesireCore 启停，不向内部智能体注册 MCP。应用市场安装需要支持 native-app 的客户端 10.0.170 及应用安装管理技能 1.5.0；隧道客户端另行安装，真实账户凭据由用户在本机提供。"
      },
      "en-US": {
        "name": "DesireCore Control",
        "summary": "Independent application for external agents to control local DesireCore instances, with ChatGPT tunnel management.",
        "description": "Runs natively on the host and discovers multiple local CDP instances. Version 1.4.0 manages the official ChatGPT tunnel client. Readonly by default, no internal MCP registration or DesireCore lifecycle coupling. Requires client 10.0.170 or newer and installation skill 1.5.0; tunnel installation and credentials are separate."
      }
    },
